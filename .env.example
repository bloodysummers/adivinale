# Neon.tech pooled connection string (used by Vercel Functions and db/scripts)
NEON_DATABASE_URL=

# URL base de la API desplegada en Vercel (usado por la app Expo)
# Ejemplo: https://adivinale.vercel.app
EXPO_PUBLIC_API_URL=

# API key de TMDB (themoviedb.org) — gratis en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# API key de RAWG (rawg.io) — gratis en https://rawg.io/apidocs
RAWG_API_KEY=
